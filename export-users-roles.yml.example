---
- name: Exportar Usuarios, Equipos y Permisos RBAC desde AAP 2.6 Gateway
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    filetree_create_folder: "/output_data"
    output_path: "/output_data"

    # Parametros de conexion contra AAP 2.6
    aap_hostname: "{{ controller_hostname | default('https://aap26gw1.bcnconsulting.com') }}"
    aap_token: "{{ controller_oauthtoken | default('TU_OAUTH_TOKEN_AQUI') }}"
    aap_validate_certs: "{{ controller_validate_certs | default(false) | bool }}"

    # Objetos a exportar: Modifica esta lista segun lo que necesites
    # Opciones: gateway_users, gateway_teams, gateway_organizations, gateway_role_definitions,
    #           gateway_role_user_assignments, gateway_role_team_assignments,
    #           controller_job_templates, controller_inventories, controller_projects, etc.
    input_tag:
      - gateway_organizations
      - gateway_users
      - gateway_teams
      - gateway_role_definitions
      - gateway_role_user_assignments
      - gateway_role_team_assignments

  roles:
    - role: infra.aap_configuration_extended.filetree_create
